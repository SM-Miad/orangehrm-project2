  "item": [
    {
      "name": "Request_1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let users;",
              "pm.test(\"Response contains user data\", function () {",
              "    users = pm.response.json();",
              "    pm.expect(users).to.be.an(\"array\").and.not.empty;",
              "});",
              "",
              "if (Array.isArray(users) && users.length > 0) {",
              "    pm.test(\"Each user contains id, name, and email\", function () {",
              "        users.forEach(function (user) {",
              "            pm.expect(user).to.have.property(\"id\");",
              "            pm.expect(user).to.have.property(\"name\");",
              "            pm.expect(user).to.have.property(\"email\");",
              "        });",
              "    });",
              "",
              "    const selectedUser = users[0];",
              "    pm.collectionVariables.set(\"userId\", selectedUser.id);",
              "    pm.collectionVariables.set(\"userPhone\", selectedUser.phone || \"\");",
              "    console.log(\"Stored userId:\", selectedUser.id);",
              "    console.log(\"Stored userPhone:\", selectedUser.phone || \"\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Request_2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let response;",
              "pm.test(\"Response is valid JSON\", function () {",
              "    response = pm.response.json();",
              "    pm.expect(response).to.be.an(\"object\");",
              "});",
              "",
              "const storedUserId = Number(pm.collectionVariables.get(\"userId\"));",
              "",
              "pm.test(\"userId was extracted from GET response\", function () {",
              "    pm.expect(Number.isFinite(storedUserId)).to.eql(true);",
              "    pm.expect(storedUserId).to.be.greaterThan(0);",
              "});",
              "",
              "if (response && Number.isFinite(storedUserId)) {",
              "    pm.test(\"Returned id matches stored userId\", function () {",
              "        pm.expect(Number(response.id)).to.eql(storedUserId);",
              "    });",
              "",
              "    pm.test(\"Phone field is not empty\", function () {",
              "        pm.expect(response).to.have.property(\"phone\");",
              "        pm.expect(response.phone).to.be.a(\"string\").and.not.empty;",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
